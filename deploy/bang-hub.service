[Unit]
Description=Bang_ver office (hub.finstar.pp.ua)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/Agent_4_me/Agent_Hub/Bang_ver
EnvironmentFile=%h/.habblaud/hub.env
Environment=HABBLAUD_PTY=1
# Absolute node path and the PATH below (a user unit has no nvm on PATH: without it `claude`/`agy` are not found, the
# terminal features switch off, and /usr/bin/node is v18). EDIT BOTH LINES (same version) when node is upgraded.
Environment=PATH=%h/.nvm/versions/node/v25.7.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v25.7.0/bin/node %h/Agent_4_me/Agent_Hub/Bang_ver/dist/server/index.js
Restart=always
RestartSec=5
# No MemoryMax on purpose: the cgroup includes the boss and seat processes (claude, agy), so a low cap
# would OOM-kill them. If you want one, size it for all of them, e.g.:
# MemoryMax=3G

[Install]
WantedBy=default.target
