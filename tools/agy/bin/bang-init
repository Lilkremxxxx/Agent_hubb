#!/usr/bin/env bash
# bang-init <folder>: prepare a project folder as an office (templates, agy skill manifest, Claude skill links, GEMINI.md, team.json folder).
[ -n "$1" ] || { echo "usage: bang-init <folder>" >&2; exit 1; }
unset CDPATH  # an exported CDPATH would make `cd` print the path and pick another folder
: "${HOME:?}"
repo=$(readlink -f "$(dirname "$(readlink -f "$0")")/../../..")
home=$HOME; case $home in */.agy_profiles/*) home=${home%%/.agy_profiles/*};; esac  # as worker-ask: the real home inside agy-as
mkdir -p "$1" && folder=$(cd "$1" && pwd -P) || exit 1
skills=$("$repo/tools/agy/bin/skill-dirs" "$home")
mkdir -p "$folder/.agents" "$folder/.claude/skills"
for n in giao-viec advisor bang-task; do
  t=$folder/.claude/skills/$n
  if [ -L "$t" ] || [ ! -e "$t" ]; then ln -sfn "$repo/skills/$n" "$t"; else echo "left .claude/skills/$n: not a link"; fi
done
[ -e "$folder/CLAUDE.md" ] || printf 'Chạy /init để điền\n' > "$folder/CLAUDE.md"
[ -e "$folder/GEMINI.md" ] || [ -L "$folder/GEMINI.md" ] || ln -s CLAUDE.md "$folder/GEMINI.md"
rc=0
SKILLS="$skills" REPO="$repo" FOLDER="$folder" HOME_="$home" DATA="${HABBLAUD_DATA_DIR:-}" python3 - <<'PY' || rc=1
import json, os, sys
repo, folder, home = os.environ["REPO"], os.environ["FOLDER"], os.environ["HOME_"]
name = os.path.basename(folder)
team = (os.environ["DATA"].strip() or f"{home}/.habblaud") + "/team.json"  # as the server (config.ts) and worker-ask
t, err = {}, None
if os.path.exists(team):
    try:
        t = json.load(open(team, encoding="utf-8"))
        if not isinstance(t, dict):
            raise ValueError("not a JSON object")
    except (OSError, ValueError) as e:
        t, err = {}, e  # copy the templates and write skills.json anyway, then fail below
b = t.get("boss") if isinstance(t.get("boss"), dict) else {}
ws = t.get("workers") if isinstance(t.get("workers"), list) else []
seats = ", ".join(f"{w['name']} {w['kind']}/{w['account']}" for w in ws if isinstance(w, dict) and all(isinstance(w.get(k), str) for k in ("name", "kind", "account")))
boss = "/".join(b[k] if isinstance(b.get(k), str) and b[k] else d for k, d in (("kind", "claude"), ("account", "default")))

def example_rows(text):  # the template's sample rows: a row or bullet right under a table rule or the lessons heading
    ls = text.split("\n")
    return [i for i in range(1, len(ls)) if ls[i].startswith(("| ", "- ")) and ls[i - 1].startswith(("|---", "## Bài học"))]

tpl = open(f"{repo}/templates/task_board.md", encoding="utf-8").read()
dst = f"{folder}/task_board.md"
if not os.path.exists(dst):
    ls = tpl.split("\n")
    for i in reversed(example_rows(tpl)):
        del ls[i]
    s = "\n".join(ls).replace("<tên dự án>", name).replace("<folder>", folder).replace("<kind/account>", boss)
    open(dst, "w", encoding="utf-8").write(s.replace("W1 agy/acc1, W2 agy/acc1, C1 claude/default", seats or "chưa có"))
else:
    have = open(dst, encoding="utf-8").read().split("\n")
    if any(tpl.split("\n")[i] in have for i in example_rows(tpl)):
        print("task_board.md still has the template's example rows (T1, W1's note, the OCR lesson): delete them, or the seats take them for real work")
dst = f"{folder}/project_proposal.md"
if not os.path.exists(dst):
    s = open(f"{repo}/templates/project_proposal.md", encoding="utf-8").read()
    open(dst, "w", encoding="utf-8").write(s.replace("<tên dự án>", name).replace("<tên>", name).replace("<folder>", folder))
entries = [{"path": d} for d in os.environ["SKILLS"].split("\n") if d]
if os.path.exists(f"{folder}/skills.list"):
    only = [l.strip() for l in open(f"{folder}/skills.list", encoding="utf-8") if l.strip() and not l.strip().startswith("#")]
    if only:  # a list of comments only is no list
        entries = [dict(e, include_only=only) for e in entries]
entries.append({"path": f"{repo}/skills"})
open(f"{folder}/.agents/skills.json", "w", encoding="utf-8").write(json.dumps({"entries": entries}, indent=2) + "\n")
accs = []
if err:
    print(f"bang-init: {team} could not be read: {err}", file=sys.stderr)
    sys.exit(1)
if not os.path.exists(team):
    print(f"no {team} yet: start the office once (it writes team.json), then run bang-init again")
else:
    accs = sorted({w["account"] for w in ws if isinstance(w, dict) and w.get("kind") == "agy" and isinstance(w.get("account"), str)})
    cur = t.get("folder")
    if not (isinstance(cur, str) and os.path.isabs(cur)):  # as the server (team.ts): a relative folder is unset
        cur = ""
    if not cur:
        t["folder"] = folder
        open(team + ".bang-init.tmp", "w", encoding="utf-8").write(json.dumps(t, indent=2, ensure_ascii=False) + "\n")
        os.replace(team + ".bang-init.tmp", team)
        print(f"office folder set in {team}")
    elif os.path.realpath(cur) == folder:
        print("already the office folder")
    else:
        print(f"the office folder is {cur}: edit {team} to change it")
print(f"""
Next:
  1. Open the boss in {folder} (the + button beside Boss on the page, or: cd {folder} && claude), then run /init.
     A boss on agy: tell it to write CLAUDE.md the way /init would.
  2. Fill in {folder}/project_proposal.md.
  3. Hand out work with the giao-viec skill (worker-ask <seat> "...").
  Antigravity jobs carry every skill description (~25k tokens); list the ones you want in {folder}/skills.list (one name per line) and run bang-init again.""")
if os.path.isdir(f"{home}/.claude-worker"):
    print(f"  4. Once: cd {folder} && CLAUDE_CONFIG_DIR={home}/.claude-worker claude  (log in, trust the folder, /exit);\n     without it every job on a Claude seat stops at TRUST_WAIT.")
if accs or not os.path.exists(team):
    print(f"  Antigravity seats: BEFORE the first job in this folder, once per account ({', '.join(accs) if accs else 'each agy account in team.json'}): cd {folder} && agy-as <acc>\n     (answer yes to the trust question, then /exit); until then worker-ask refuses the job.")
PY
exit $rc
