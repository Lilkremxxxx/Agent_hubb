#!/usr/bin/env python3
"""agy-ask <seat> "<prompt>" [--mode plan|accept-edits|auto|default] [--effort …] [--model M] [--lean] [--raw] [--role NAME] [--cwd DIR] [--max N] [--timeout SEC]
agy-ask team                                       print the folder, the boss and the seats

Gives one job to a seat of the office and prints ONLY its final answer (capped at --max chars, default 2000). The seat
is named in <dataDir>/team.json ($HABBLAUD_DATA_DIR, default ~/.habblaud): {folder, boss, workers: [{name, kind,
account}]}, e.g. W1 = agy acc1, C1 = Claude Code account "worker" (~/.claude-worker; "default" = ~/.claude). The seat
decides the agent: agy-ask and claude-ask are the same file under two names. Anyone may give jobs: there is no team
rule and no check of who is calling.

The job runs in --cwd, else in the office folder (the "folder" of team.json; no folder and no --cwd = error).
Through the office (the server at $HABBLAUD_URL, default http://127.0.0.1:4747): the job goes into the seat's own
terminal (POST /api/workers/ask) as a fresh conversation, and this call waits on GET /api/workers/jobs/<id>?wait=60,
spending nothing while it waits; the server sends back the final answer only. If the office is not running (no
answer, 404, 503), the job runs headless: the repo's agy-as (next to this script) with agy -p (stream-json; stops at
the result event, kills the process group, deletes that call's conversation files) or claude -p --output-format json
(no session saved), with BANG_SLOT=<seat> and BANG_OFFICE=<folder> in its environment. Headless calls log
"start"/"end" lines to ~/.agy_profiles/agy-ask.log.jsonl (via "headless").

The prompt must have the giao-viec headings (the title "# Việc <ID> — <tên>" and the sections Bối cảnh, Input, Skill dùng,
Cách làm, Output, Tiêu chí review); --raw sends it as is.

Claude Code seats run full (all tools, MCP and skills); --lean starts them light: no MCP servers, no skills or slash
commands, only the tools in LEAN_TOOLS, plus a short worker rule (answer only, compact, under --max chars).

Exit codes: 0 done; 1 failed, timeout, unknown seat or no folder; 2 refused by the office (403); 3 BUSY: the seat is on
another job (ask again when it is over, or pick another seat); 4 the job was cancelled (from the office).

Antigravity seats only run Gemini 3.8 Flash: --model accepts only gemini-3.8-flash[-low|-medium|-high], --effort only
low, medium, high. Without --mode / --effort an agy seat uses its account's defaults in ~/.agy_profiles/defaults.json
({"acc2": {"mode": "plan", "effort": "low"}}), else mode plan (agy) or default (Claude).
"""
import glob, json, os, re, signal, subprocess, sys, threading, time, unicodedata, urllib.error, urllib.parse, urllib.request


def real_home():
    """The user's home, also from inside an Antigravity profile (agy-as runs agy and its tools with HOME=~/.agy_profiles/accN)."""
    home = os.path.expanduser("~")
    m = re.match(r"^(.*)/\.agy_profiles/[^/]+/?$", home)
    return m.group(1) if m else home


HOME = real_home()
ROOT = os.environ.get("HABBLAUD_AGY_PROFILES") or f"{HOME}/.agy_profiles"
LOG = f"{ROOT}/agy-ask.log.jsonl"
DEFAULTS = f"{ROOT}/defaults.json"
DATA = (os.environ.get("HABBLAUD_DATA_DIR") or "").strip() or f"{HOME}/.habblaud"  # as the server resolves it
TEAM = f"{DATA}/team.json"
URL = (os.environ.get("HABBLAUD_URL") or "http://127.0.0.1:4747").rstrip("/")
CMD = "claude-ask" if os.path.basename(sys.argv[0]).startswith("claude") else "agy-ask"
USAGE = __doc__.splitlines()[0]

OK, FAIL, REFUSED, BUSY, CANCELLED = 0, 1, 2, 3, 4
MODES = ("plan", "accept-edits", "auto", "default")
AGY_EFFORTS = ("low", "medium", "high")  # Gemini 3.8 Flash thinking levels
CLAUDE_EFFORTS = ("low", "medium", "high", "xhigh", "max")
AGY_MODEL = "gemini-3.8-flash"  # the only model Antigravity workers use
CLAUDE_MODES = {"plan": "plan", "accept-edits": "acceptEdits", "auto": "auto", "default": ""}
# The giao-viec template (spec §11): the title, then 6 sections; matched at the start of a line.
HEADINGS = ("# Việc <ID> — <tên>", "## Bối cảnh", "## Input", "## Skill dùng", "## Cách làm", "## Output", "## Tiêu chí review")
LEAN_TOOLS = "Bash,Read,Edit,Write,WebFetch,WebSearch"
WORKER_RULE = ("You are a worker: another agent gave you this one job and reads only your final message. Do the job, "
               "then reply with just the result, compact (no preamble, no recap of your steps), under {max} characters. "
               "If you could not do it, say so plainly and why.")
# Claude Code puts these into the environment of its tools: a claude started with them thinks it is a child session.
CLAUDE_SESSION_VARS = ("CLAUDECODE", "AI_AGENT", "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_CODE_CHILD_SESSION",
                       "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_ENTRYPOINT",
                       "CLAUDE_CODE_EXECPATH", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                       "CLAUDE_CODE_SSE_PORT")
# Set for an Antigravity boss (its terminal loads the boss rules): a seat started from the boss's shell must not get them.
BOSS_VARS = ("AGY_BOSS", "AGY_OFFICE")


def die(msg, code=FAIL):
    print(f"{CMD}: {msg}", file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------------ the team and the arguments

def team():
    """The team file {folder, boss, workers}; die when it is missing or broken."""
    try:
        with open(TEAM) as f:
            t = json.load(f)
        if not isinstance(t, dict):
            raise ValueError("not an object")
    except (OSError, ValueError):
        die(f"no team file {TEAM}: start the office once or write it")
    return t


def seats(t):
    """The seats the server keeps (parseTeam): valid name, kind and account; the first of a duplicate name wins."""
    out = []
    for w in t.get("workers") or []:
        if (isinstance(w, dict) and isinstance(w.get("name"), str) and re.match(r"^[A-Za-z][\w-]{0,15}$", w["name"])
                and w.get("kind") in ("claude", "agy") and isinstance(w.get("account"), str)
                and re.match(r"^[\w.-]+$", w["account"]) and all(x["name"] != w["name"] for x in out)):
            out.append(w)
    return out


def flag(extra, name):
    """Value of a flag passed through (e.g. --model X), or ""."""
    return extra[extra.index(name) + 1] if name in extra[:-1] else ""


def missing_headings(task):
    """The HEADINGS not found in the task, in order. Any case, any dash in the title, text may follow on the line."""
    text = unicodedata.normalize("NFC", task)
    return [h for h in HEADINGS
            if not re.search(r"^#[ \t]+Việc[ \t]+\S" if h[:2] == "# " else rf"^##[ \t]+{re.escape(h[3:])}", text, re.M | re.I)]


def parse(argv):
    if len(argv) < 2:
        die(f"usage: {USAGE}")
    t = team()
    found = [w for w in seats(t) if w["name"] == argv[0]]
    if not found:
        die(f"no seat {argv[0]} (seats: {', '.join(w['name'] for w in seats(t))})")
    seat = found[0]
    a = {"worker": seat["name"], "kind": seat["kind"], "account": seat["account"],
         "prompt": argv[1], "task": argv[1], "mode": "", "role": "", "effort": "", "model": "", "max": 2000, "cwd": "",
         "timeout": 900, "lean": False, "raw": False, "extra": []}
    rest = argv[2:]
    while rest:
        k = rest.pop(0)
        if k in ("--mode", "--role", "--max", "--cwd", "--timeout", "--effort", "--model"):
            if not rest:
                die(f"{k} needs a value")
            v = rest.pop(0)
            try:
                a[k[2:]] = int(v) if k in ("--max", "--timeout") else v
            except ValueError:
                die(f"{k} needs a number")
        elif k == "--lean":
            a["lean"] = True
        elif k == "--raw":
            a["raw"] = True
        else:
            a["extra"].append(k)  # passed to agy / claude as is
    miss = [] if a["raw"] else missing_headings(a["task"])
    if miss:
        die(f"the prompt lacks {', '.join(miss)}: write the job in the 6 parts of the giao-viec skill, or pass --raw to send it as is")
    agy = a["kind"] == "agy"
    efforts = AGY_EFFORTS if agy else CLAUDE_EFFORTS
    if a["effort"] and a["effort"] not in efforts:
        die(f"--effort must be one of {', '.join(efforts)}")
    if agy and a["model"] and a["model"] not in [AGY_MODEL] + [f"{AGY_MODEL}-{e}" for e in AGY_EFFORTS]:
        die(f"agy seats only use {AGY_MODEL} (got --model {a['model']!r}); choose the thinking level with --effort")
    if a["mode"] and a["mode"] not in MODES and not (not agy and a["mode"] in CLAUDE_MODES.values()):
        die(f"--mode must be one of {', '.join(MODES)}")
    d = defaults(a["account"]) if agy else {}
    a["mode"] = a["mode"] or d.get("mode") or ("plan" if agy else "default")
    if not a["effort"] and d.get("effort") in efforts:
        a["effort"] = d["effort"]
    a["given_cwd"] = bool(a["cwd"])
    f = t.get("folder")  # a relative folder counts as none, like the server; BANG_OFFICE gets it normalized
    a["folder"] = os.path.normpath(f) if isinstance(f, str) and os.path.isabs(f) else ""
    cwd = a["cwd"] or a["folder"]
    if not cwd or not os.path.isdir(cwd):
        die(f'the office has no folder yet: set "folder" in {TEAM}' if not a["cwd"] else f"no such directory {cwd}")
    a["cwd"] = os.path.abspath(cwd)
    return a


def defaults(account):
    """The account's defaults for calls that do not say (defaults.json), or {}."""
    try:
        with open(DEFAULTS) as f:
            d = json.load(f).get(account)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError, AttributeError):
        return {}


def print_team():
    t = team()
    boss = t.get("boss") if isinstance(t.get("boss"), dict) else {}
    print(f"folder: {t.get('folder') or 'none yet'}")
    print(f"boss: {boss.get('kind') or 'claude'} ({boss.get('account') or 'default'})")
    for w in seats(t):
        print(f"{w['name']}  {w.get('kind')}  {w.get('account')}")


# ------------------------------------------------------------------ the office (Habblaud)

class NoOffice(Exception):
    """The office is not running or has no worker terminals: run headless."""


def http(method, path, body=None, timeout=10):
    """(status, json) from the office; NoOffice when it does not answer."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(URL + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"} if data is not None else {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            payload = json.loads(e.read() or b"{}")
        except ValueError:
            payload = {}
        return e.code, payload if isinstance(payload, dict) else {}
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise NoOffice(str(e))


def busy_help(worker, message):
    print(f"{CMD}: {worker} is busy: {message}", file=sys.stderr)
    print(f"{CMD}: it is on another job: ask again when that one is over, or give the job to another worker", file=sys.stderr)
    sys.exit(BUSY)


def via_office(a):
    """Runs the job in the seat's terminal and waits for its answer; NoOffice to fall back to headless."""
    # The office takes the agy mode names (plan, accept-edits, auto, default), also for Claude Code workers.
    mode = {v: k for k, v in CLAUDE_MODES.items() if v}.get(a["mode"], a["mode"])
    body = {"worker": a["worker"], "prompt": a["prompt"], "max": a["max"], "mode": mode}
    if a["given_cwd"]:  # without it the server runs the job in the office folder
        body["cwd"] = a["cwd"]
    for k in ("role", "effort", "model"):
        if a[k]:
            body[k] = a[k]
    if a["kind"] == "claude" and a["lean"]:
        body["lean"] = True
    status, r = http("POST", "/api/workers/ask", body)
    if status in (404, 503):
        raise NoOffice(r.get("error") or str(status))
    if status == 409:
        busy_help(a["worker"], r.get("message") or r.get("error") or "BUSY")
    if status == 403:
        die(r.get("error") or "refused by the office", REFUSED)
    if status >= 300 or not isinstance(r.get("job"), dict):
        die(r.get("error") or f"the office answered {status}")
    job = r["job"]
    t0, deadline = time.time(), time.time() + a["timeout"]

    def cancel(*_):
        try:
            http("POST", "/api/workers/cancel", {"job": job["id"]}, timeout=5)
        except NoOffice:
            pass

    def on_signal(sig, _):  # the caller gave up (Bash timeout, Ctrl-C): cancel the job in the office too
        cancel()
        sys.exit(128 + sig)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    misses = 0
    while job.get("status") in ("queued", "working"):
        left = deadline - time.time()
        if left <= 0:
            cancel()
            die(f"{a['worker']} TIMEOUT after {round(time.time() - t0)}s (job cancelled)")
        try:
            status, r = http("GET", f"/api/workers/jobs/{urllib.parse.quote(job['id'])}?wait={max(1, min(60, int(left)))}",
                             timeout=min(60, left) + 15)
            misses = 0
        except NoOffice as e:  # the office went away mid-job: the job may still be running there
            misses += 1
            if misses >= 3:
                die(f"lost the office while waiting for job {job['id']}: {e}")
            time.sleep(2)
            continue
        if status != 200 or not isinstance(r.get("job"), dict):
            die(r.get("error") or f"the office answered {status} for job {job['id']}")
        job = r["job"]
    st = job.get("status")
    if st == "done":
        out = (job.get("answer") or "").rstrip("\n")
        print(out if len(out) <= a["max"] else f"{out[:a['max']]}\n[... cut at {a['max']} chars]")
        sys.exit(OK)
    if st == "cancelled":
        die(f"job {job['id']} on {a['worker']} was cancelled from the office", CANCELLED)
    die(f"{a['worker']} {st or 'ERROR'} after {round(time.time() - t0)}s: {job.get('error') or ''}".rstrip(": "))


# ------------------------------------------------------------------ headless (no office)

def log(entry):
    try:
        with open(LOG, "a") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        pass


def log_acc(a):
    """The key the office files a log line under: the Antigravity account, else the seat."""
    return a["account"] if a["kind"] == "agy" else a["worker"]


def log_start(a, t0):
    log({"event": "start", "ts": t0, "acc": log_acc(a), "worker": a["worker"], "via": "headless", "pid": os.getpid(), "mode": a["mode"],
         "role": a["role"], "model": a["model"], "effort": a["effort"], "cwd": a["cwd"], "prompt": a["task"][:200]})


def log_end(a, t0, **fields):
    log({"event": "end", "ts": time.time(), "acc": log_acc(a), "worker": a["worker"], "via": "headless",
         "pid": os.getpid(), "sec": round(time.time() - t0), **fields})


def finish(a, t0, status, answer, other, fields):
    """Logs the end, prints the answer (or the error) and exits."""
    end = {"status": status, **fields}
    if status != "SUCCESS":  # last error lines (e.g. 429 "Individual quota reached"): Habblaud shows quota hits
        end["error"] = ("\n".join(other[-5:]) or answer or "")[-300:]
    log_end(a, t0, **end)
    if status != "SUCCESS":
        print(f"{CMD}: {a['worker']} {status} after {round(time.time() - t0)}s:", file=sys.stderr)
        print("\n".join(other[-5:]) or answer, file=sys.stderr)
        sys.exit(FAIL)
    out = (answer or "").rstrip("\n")
    print(out if len(out) <= a["max"] else f"{out[:a['max']]}\n[... cut at {a['max']} chars]")
    sys.exit(OK)


def headless_agy(a):
    acc = a["account"]
    cmd = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "agy-as"), acc, "-p", a["prompt"], "--output-format", "stream-json"]
    if a["mode"] != "default":
        cmd += ["--mode", a["mode"]]
    if a["effort"]:
        cmd += ["--effort", a["effort"]]
    if a["model"]:
        cmd += ["--model", a["model"]]
    cmd += a["extra"]
    env = {k: v for k, v in os.environ.items() if k not in BOSS_VARS}
    env.update(BANG_SLOT=a["worker"], BANG_OFFICE=a["folder"], PATH=f"{HOME}/.local/bin:" + env.get("PATH", ""))
    t0 = time.time()
    log_start(a, t0)
    p = subprocess.Popen(cmd, cwd=a["cwd"], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                         stderr=subprocess.STDOUT, text=True, start_new_session=True)
    st = {"cid": None, "result": None, "other": []}

    def cleanup(*_):
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        if st["cid"]:  # a killed call leaves a ~32 MB .db-wal behind
            conv = f"{HOME}/.agy_profiles/{acc}/.gemini/antigravity-cli/conversations/{st['cid']}.db"
            for f in glob.glob(conv + "*"):
                try:
                    os.remove(f)
                except OSError:
                    pass

    def on_signal(sig, _):  # caller gave up (Bash timeout, Ctrl-C): take the worker down with us
        cleanup()
        log_end(a, t0, cid=st["cid"], status="KILLED")
        sys.exit(128 + sig)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    def reader():
        for ln in p.stdout:
            if ln.startswith('{"event":"init"'):
                st["cid"] = json.loads(ln).get("conversation_id")
            elif ln.startswith('{"event":"result"'):
                st["result"] = json.loads(ln).get("result", {})
                return
            elif not ln.startswith('{"event":'):
                st["other"].append(ln.rstrip())  # errors, quota messages

    th = threading.Thread(target=reader, daemon=True)
    th.start()
    th.join(a["timeout"])
    cleanup()
    r = st["result"] or {}
    status = r.get("status") or ("TIMEOUT" if th.is_alive() else "NO_RESULT")
    finish(a, t0, status, r.get("response", ""), st["other"],
           {"cid": st["cid"], "turns": r.get("num_turns"), "usage": r.get("usage")})


def headless_claude(a):
    account = "" if a["account"] == "default" else "-" + a["account"]  # default = ~/.claude, x = ~/.claude-x
    conf = f"{HOME}/.claude{account}"
    if not os.path.isdir(conf):
        die(f"no Claude Code account folder {conf}")
    cmd = ["claude", "-p", a["prompt"], "--output-format", "json", "--no-session-persistence"]
    mode = CLAUDE_MODES.get(a["mode"], a["mode"])
    if mode:
        cmd += ["--permission-mode", mode]
    if a["effort"]:
        cmd += ["--effort", a["effort"]]
    if a["model"]:
        cmd += ["--model", a["model"]]
    if a["lean"]:
        cmd += ["--strict-mcp-config", "--disable-slash-commands",
                "--append-system-prompt", WORKER_RULE.format(max=a["max"])]
        if "--tools" not in a["extra"]:
            cmd += ["--tools", LEAN_TOOLS]
    cmd += a["extra"]
    env = {k: v for k, v in os.environ.items() if k not in CLAUDE_SESSION_VARS + BOSS_VARS}
    env.update(BANG_SLOT=a["worker"], BANG_OFFICE=a["folder"], PATH=f"{HOME}/.local/bin:" + env.get("PATH", ""))
    if account:
        env["CLAUDE_CONFIG_DIR"] = conf
    else:
        env.pop("CLAUDE_CONFIG_DIR", None)
    t0 = time.time()
    log_start(a, t0)
    p = subprocess.Popen(cmd, cwd=a["cwd"], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, text=True, start_new_session=True)

    def kill():
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    def on_signal(sig, _):
        kill()
        log_end(a, t0, status="KILLED")
        sys.exit(128 + sig)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    try:
        out, err = p.communicate(timeout=a["timeout"])
    except subprocess.TimeoutExpired:
        kill()
        finish(a, t0, "TIMEOUT", "", [], {})
    try:
        r = json.loads(out.strip().splitlines()[-1]) if out.strip() else {}
    except ValueError:
        r = {}
    ok = r.get("subtype") == "success" and not r.get("is_error")
    u = r.get("usage") or {}
    usage = None
    if u:
        usage = {"input_tokens": u.get("input_tokens", 0), "output_tokens": u.get("output_tokens", 0),
                 "cache_read_tokens": u.get("cache_read_input_tokens", 0),
                 "cache_creation_tokens": u.get("cache_creation_input_tokens", 0)}
        usage["total_tokens"] = sum(usage.values())
        if r.get("total_cost_usd") is not None:
            usage["cost_usd"] = r["total_cost_usd"]
    other = [ln for ln in (err or "").splitlines() if ln.strip()] or ([] if ok else [ln for ln in out.splitlines() if ln.strip()][-5:])
    finish(a, t0, "SUCCESS" if ok else (r.get("subtype") or "ERROR").upper(), r.get("result", ""), other,
           {"cid": r.get("session_id"), "turns": r.get("num_turns"), "usage": usage})


# ------------------------------------------------------------------ main

def main():
    argv = sys.argv[1:]
    if argv == ["team"]:
        return print_team()
    if argv[:1] == ["rules"]:
        die("unknown subcommand: rules (office rules were removed)")
    a = parse(argv)
    try:
        via_office(a)
    except NoOffice:
        pass
    (headless_agy if a["kind"] == "agy" else headless_claude)(a)


if __name__ == "__main__":
    main()
